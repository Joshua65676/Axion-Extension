{
  "manifest_version": 3,
  "name": "Axion Twitter Bookmark Scraper",
  "version": "1.0",
  "description": "Scrapes Twitter/X bookmarks and sends them to Axion.",
  "permissions": ["storage", "scripting", "activeTab"],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.x.com/*",
    "https://www.twitter.com/*",
    "http://localhost/*",
    "http://localhost:10000/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:10000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Axion",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.x.com/*",
        "https://www.twitter.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}